{
  "_comment": "Control registry for the terrain look lab. The UI, randomizer, and lock system are all built from this. type: slider|toggle|enum|material|companion. param = shader uniform (for slider/toggle/enum that map straight through). rand=false excludes from the randomizer. zone-indexed controls (material/companion) expand to 7 rows. Edit this to add/tune a control with no C# change.",
  "zone_names": ["valley", "valley→slope", "slope", "slope→cliff", "cliff", "high", "peak/snow"],
  "tabs": ["Zones", "Surface", "Color", "Detail", "Splat", "Debug"],
  "controls": [
    { "id": "zone_mat", "label": "zone", "tab": "Zones", "type": "material", "rand": true },
    { "id": "companion", "label": "companion", "tab": "Zones", "type": "companion", "rand": true,
      "default": [1, 2, 1, 4, 5, 4, 5] },

    { "id": "mask_mode", "label": "mask mode", "tab": "Surface", "type": "enum", "setter": "mask",
      "options": ["height bands", "height+slope", "noise-broken", "curvature", "steep=cliff", "noise biomes"],
      "default": 2, "rand": true },
    { "id": "tile_mode", "label": "tile mode", "tab": "Surface", "type": "enum", "param": "tile_mode",
      "options": ["none (sharp)", "IQ 2-tap", "hex-tiling"], "default": 1, "rand": false },
    { "id": "tex_scale_m", "label": "tex scale m", "tab": "Surface", "type": "slider",
      "param": "tex_scale_m", "min": 4, "max": 80, "default": 28, "rand": true },
    { "id": "tri_sharpness", "label": "tri sharp", "tab": "Surface", "type": "slider",
      "param": "tri_sharpness", "min": 1, "max": 32, "default": 8, "rand": true },
    { "id": "hex_rot_strength", "label": "hex rot", "tab": "Surface", "type": "slider",
      "param": "hex_rot_strength", "min": 0, "max": 1, "default": 0.7, "rand": true },
    { "id": "hex_contrast", "label": "hex contrast", "tab": "Surface", "type": "slider",
      "param": "hex_contrast", "min": 0.3, "max": 1, "default": 0.7, "rand": true },
    { "id": "blend_mode", "label": "blend mode", "tab": "Surface", "type": "enum", "setter": "blend",
      "options": ["flat albedo", "full PBR", "PBR+anti-tile", "+macro tint", "full stack"],
      "default": 3, "rand": false },

    { "id": "macro_on", "label": "macro color", "tab": "Color", "type": "toggle",
      "param": "macro_on", "default": true, "rand": true },
    { "id": "macro_val_amp", "label": "macro val", "tab": "Color", "type": "slider",
      "param": "macro_val_amp", "min": 0, "max": 0.6, "default": 0.22, "rand": true },
    { "id": "macro_hue_amp", "label": "macro hue", "tab": "Color", "type": "slider",
      "param": "macro_hue_amp", "min": 0, "max": 0.2, "default": 0.05, "rand": true },
    { "id": "macro_sat_amp", "label": "macro sat", "tab": "Color", "type": "slider",
      "param": "macro_sat_amp", "min": 0, "max": 0.6, "default": 0.18, "rand": true },
    { "id": "macro_scale2", "label": "macro scl2", "tab": "Color", "type": "slider",
      "param": "macro_scale2", "min": 60, "max": 400, "default": 170, "rand": true },

    { "id": "contact_on", "label": "contact shade", "tab": "Detail", "type": "toggle",
      "param": "contact_on", "default": true, "rand": true },
    { "id": "crevice_amp", "label": "crevice", "tab": "Detail", "type": "slider",
      "param": "crevice_amp", "min": 0, "max": 1, "default": 0.45, "rand": true },
    { "id": "crevice_range", "label": "crev range", "tab": "Detail", "type": "slider",
      "param": "crevice_range", "min": 0.5, "max": 8, "default": 2.5, "rand": true },
    { "id": "slope_wear_amp", "label": "slope wear", "tab": "Detail", "type": "slider",
      "param": "slope_wear_amp", "min": 0, "max": 1, "default": 0.35, "rand": true },
    { "id": "snow_dust_amp", "label": "snow dust", "tab": "Detail", "type": "slider",
      "param": "snow_dust_amp", "min": 0, "max": 1, "default": 0, "rand": true },

    { "id": "splat_on", "label": "splat mix", "tab": "Splat", "type": "toggle",
      "param": "splat_on", "default": true, "rand": true },
    { "id": "mix_strength", "label": "mix strength", "tab": "Splat", "type": "slider",
      "param": "mix_strength", "min": 0, "max": 1, "default": 0.6, "rand": true },
    { "id": "heightblend_on", "label": "height blend", "tab": "Splat", "type": "toggle",
      "param": "heightblend_on", "default": true, "rand": true },
    { "id": "heightblend_sharp", "label": "hb sharp", "tab": "Splat", "type": "slider",
      "param": "heightblend_sharp", "min": 0.1, "max": 0.9, "default": 0.6, "rand": false },
    { "id": "band_soft_mult", "label": "band soft", "tab": "Splat", "type": "slider",
      "param": "band_soft_mult", "min": 0.3, "max": 3, "default": 1.4, "rand": true },
    { "id": "mix_scale_m", "label": "mix scale m", "tab": "Splat", "type": "slider",
      "field": "MixScaleM", "min": 8, "max": 120, "default": 26, "rand": true, "rebake": true },
    { "id": "mix_bias", "label": "mix bias", "tab": "Splat", "type": "slider",
      "field": "MixBias", "min": 0.1, "max": 0.9, "default": 0.5, "rand": true, "rebake": true },
    { "id": "splat_debug", "label": "splat debug", "tab": "Splat", "type": "enum", "param": "splat_debug",
      "options": ["off", "zones", "mix amt"], "default": 0, "rand": false },

    { "id": "dbg_normalmap", "label": "normal maps", "tab": "Debug", "type": "toggle",
      "param": "dbg_use_normalmap", "default": true, "rand": false },
    { "id": "dbg_fullrough", "label": "force matte (no spec)", "tab": "Debug", "type": "toggle",
      "param": "dbg_fullrough", "default": false, "rand": false },
    { "id": "dbg_ssao", "label": "SSAO", "tab": "Debug", "type": "scene", "scene": "ssao", "default": true, "rand": false },
    { "id": "dbg_shadow", "label": "sun shadows", "tab": "Debug", "type": "scene", "scene": "shadow", "default": true, "rand": false },
    { "id": "dbg_fog", "label": "fog", "tab": "Debug", "type": "scene", "scene": "fog", "default": true, "rand": false },
    { "id": "dbg_sun", "label": "sun (vs flat ambient)", "tab": "Debug", "type": "scene", "scene": "sun", "default": true, "rand": false }
  ]
}
