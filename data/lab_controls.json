{
  "_comment": "Control registry for the terrain look lab. The UI, randomizer, and lock system are all built from this. type: slider|toggle|enum|material|companion. param = shader uniform (for slider/toggle/enum that map straight through). rand=false excludes from the randomizer. zone-indexed controls (material/companion) expand to 7 rows. Edit this to add/tune a control with no C# change.",
  "zone_names": ["valley", "valley→slope", "slope", "slope→cliff", "cliff", "high", "peak/snow"],
  "tabs": ["Zones", "Surface", "Color", "Detail", "Splat", "Light", "Debug"],
  "controls": [
    { "id": "zone_mat", "label": "zone", "tab": "Zones", "type": "material", "rand": true },
    { "id": "companion", "label": "companion", "tab": "Zones", "type": "companion", "rand": true,
      "default": [1, 2, 1, 4, 5, 4, 5] },

    { "id": "mask_mode", "label": "mask mode", "tab": "Surface", "type": "enum", "setter": "mask",
      "options": ["height bands", "height+slope", "noise-broken", "curvature", "steep=cliff", "noise biomes"],
      "default": 2, "rand": true },
    { "id": "tile_mode", "label": "tile mode", "tab": "Surface", "type": "enum", "param": "tile_mode",
      "options": ["none (sharp)", "IQ 2-tap", "hex-tiling"], "default": 1, "rand": false },
    { "id": "tex_scale_m", "label": "tex scale m", "tab": "Surface", "type": "slider",
      "param": "tex_scale_m", "min": 4, "max": 80, "default": 28, "rand": true },
    { "id": "tri_sharpness", "label": "tri sharp", "tab": "Surface", "type": "slider",
      "param": "tri_sharpness", "min": 1, "max": 32, "default": 8, "rand": true },
